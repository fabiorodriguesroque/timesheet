{
  "name": "@repo/api",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "lint": "oxlint --type-aware",
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:reset": "bun src/db/reset.ts && drizzle-kit migrate"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.18",
    "better-auth": "^1.7.18",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^1.0.0-rc.5",
    "hono": "^4.13.16",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@repo/oxlint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "latest",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^1.0.0-rc.5",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "7.0.2"
  }
}
