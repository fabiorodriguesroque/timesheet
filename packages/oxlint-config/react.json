{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./base.json"],
  "plugins": ["typescript", "oxc", "unicorn", "import", "react", "jsx-a11y"],
  "env": {
    "browser": true
  },
  "settings": {
    "react": {
      "version": "19"
    }
  },
  "rules": {
    // React 17+ JSX transform: no need to import React in scope
    "react/react-in-jsx-scope": "off"
  }
}
